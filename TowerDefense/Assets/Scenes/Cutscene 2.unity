  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneController
  cutsceneLine:
  - dialogue: Hi there, a nurse said you were asking for me?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: Yeah.
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: "\u2026"
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: "\u2026"
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: Are you feeling alright? You pressed your call button.
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: I feel.. um..
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: I'll tell the nurses, they can help you with that. A lot of people
      feel that way during treatment, so there's no need to worry.
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: ...
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: Did you have another question?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: ...
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: You can ask me anything that's on your mind, it's okay.
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: Why did I have to come back?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: What do you mean?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: "Why am I still sick? You said I\u2019d get better when you treated
      the bad stuff in my blood, Mom said I would too."
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: Treatment can take a long time. It takes a while for you to feel better.
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: Do I have to take more medicine?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: "You do, but you\u2019ll be taking new kinds in a few days. One of
      your nurses said you hated taking all those pills, so that\u2019s a good thing,
      right?"
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: No more pills at all?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: "You\u2019ll still have some, but we\u2019re going to be using an IV."
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: The needle thing?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: Yeah, you had one when you first came to visit us, remember?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: "\u2026"
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: "I know it\u2019s scary, but it\u2019ll help you a lot."
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: "But they hurt! I don\u2019t like them."
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: "\u2026"
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: Do you know what an IV does?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: '*sniff* No...'
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: "An IV sends the medicine swimming up your arm and into your blood.
      It\u2019s really strong too. If you want, we\u2019ll even use the one with
      the butterfly on it so it won\u2019t hurt at all."
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: "It\u2019s not a butterfly."
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: What?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: "It\u2019s that fish on the wall."
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: A stingray?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: Yeah.
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: Well, the stingray will help you.
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: Is it going to make me feel better?
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: Soon.
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: ...
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: "I\u2019ll tell you more about it tomorrow, okay?"
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  - dialogue: Okay... Bye Ms. Doctor.
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 0
  - dialogue: I'll see you soon, make sure you get some good sleep.
    p1: {fileID: 3220444687615995917, guid: 1b96e96dc722a5043805d0ada7d0d421, type: 3}
    p2: {fileID: 338164770463493611, guid: 042b49998d9a2674da09e7db85ed975c, type: 3}
    dialogueSpeed: 0
    isChoice: 0
    whostalking: 1
  baseTalkSpeed: 0.01
  choiceUI: {fileID: 1349329476}
  textBox: {fileID: 1402569987}
  personA: {fileID: 496296715}
  personB: {fileID: 2056242955}
  nextScene: Level 2
